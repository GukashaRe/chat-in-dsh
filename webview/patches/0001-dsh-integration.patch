+import { create } from 'zustand'
+
+/** 搜索浮层的开关、关键词，以及「点结果后要滚到的消息」。 */
+type SessionSearchState = {
+  open: boolean
+  query: string
+  pending: { sessionId: string; messageId: string } | null
+}
+
+export const useSessionSearch = create<SessionSearchState>(() => ({ open: false, query: '', pending: null }))
+
+export const openSessionSearch = () => useSessionSearch.setState({ open: true })
+
+export const closeSessionSearch = () => useSessionSearch.setState({ open: false, query: '' })
+
+export const setSessionSearchQuery = (query: string) => useSessionSearch.setState({ query })
+
+/** 记录目标消息，等会话加载完后由消息列表消费。 */
+export const requestScrollToMessage = (sessionId: string, messageId: string) =>
+  useSessionSearch.setState({ pending: { sessionId, messageId }, open: false })
+
+export const consumeScrollTarget = () => useSessionSearch.setState({ pending: null })
