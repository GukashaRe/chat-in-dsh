diff --git a/src/components/messages/TurnRail.module.css b/src/components/messages/TurnRail.module.css
new file mode 100644
index 0000000..b1db403
--- /dev/null
+++ b/src/components/messages/TurnRail.module.css
@@ -0,0 +1,205 @@
+/* 官网 scrollNav 几何：右侧 16px、34px 毛玻璃胶囊；悬停时内部容器展开、最宽 240px。 */
+.rail {
+  position: fixed;
+  top: 50%;
+  right: 16px;
+  z-index: 5;
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  width: 34px;
+  transform: translateY(-50%);
+  user-select: none;
+  transition: all 0.2s;
+}
+
+.bg {
+  position: absolute;
+  top: 50%;
+  right: 0;
+  z-index: -1;
+  width: 34px;
+  height: calc(100% - 8px);
+  max-height: calc(100% - 8px);
+  border-radius: 16px;
+  background-color: rgba(255, 255, 255, 0.8);
+  -webkit-backdrop-filter: blur(5px);
+  backdrop-filter: blur(5px);
+  transform: translateY(-50%);
+}
+
+.nav {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  flex-shrink: 0;
+  box-sizing: border-box;
+  width: fit-content;
+  max-width: 240px;
+  overflow: hidden;
+  border: 1px solid transparent;
+  border-radius: 16px;
+  pointer-events: none;
+  transition:
+    background 0.2s,
+    box-shadow 0.2s;
+}
+
+.rail[data-show='true'] .nav {
+  pointer-events: auto;
+  border-color: var(--dsw-alias-border-inverted);
+  background: var(--dsw-alias-bg-layer-1, var(--dsw-alias-bg-layer-2));
+  box-shadow: var(--dsw-shadow-lv3);
+}
+
+/* 条目多于 8 条时固定 240px 宽，避免整列过宽 */
+.nav[data-many='true'] {
+  width: 240px;
+}
+
+.nav::before,
+.nav::after {
+  content: '';
+  position: absolute;
+  left: 0;
+  z-index: 2;
+  width: 100%;
+  height: 32px;
+  pointer-events: none;
+  opacity: 0;
+  background: linear-gradient(var(--dsw-alias-bg-layer-1, var(--dsw-alias-bg-layer-2)) 20.19%, rgba(255, 255, 255, 0) 100%);
+  transition: opacity 0.2s;
+}
+
+.nav::before {
+  top: 0;
+}
+
+.nav::after {
+  bottom: 0;
+  transform: rotate(180deg);
+}
+
+.rail[data-show='true'] .nav[data-top='true']::before,
+.rail[data-show='true'] .nav[data-bottom='true']::after {
+  opacity: 1;
+}
+
+.page {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  box-sizing: border-box;
+  max-height: 250px;
+  padding: 15px 0 15px 24px;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  scrollbar-width: none;
+}
+
+.page::-webkit-scrollbar {
+  display: none;
+}
+
+/* 行高 30px；宽度留出 6px 的右边距，与官网一致 */
+.item {
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  flex-shrink: 0;
+  box-sizing: border-box;
+  width: calc(100% - 6px);
+  height: 30px;
+  margin-right: 8px;
+  color: var(--dsw-alias-label-tertiary);
+  line-height: 20px;
+  cursor: pointer;
+}
+
+/* 标题保持固有宽度：短标题自然右对齐，长标题在 240px 内截断 */
+.itemTitle {
+  min-width: 0;
+  max-width: 100%;
+  margin-right: 12px;
+  overflow: hidden;
+  font: var(--dsw-font-xs-13);
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  text-align: left;
+  opacity: 0;
+  transition:
+    opacity 0.1s,
+    color 0.2s;
+}
+
+.rail[data-show='true'] .itemTitle {
+  opacity: 1;
+}
+
+.item:hover .itemTitle {
+  color: var(--dsw-alias-label-primary);
+}
+
+.item[data-active='true'] .itemTitle {
+  color: var(--dsw-alias-brand-text);
+  font-weight: 500;
+}
+
+.itemIndicator {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  width: 16px;
+  height: 20px;
+}
+
+.indicatorLine {
+  flex-shrink: 0;
+  width: 8px;
+  height: 2px;
+  border-radius: 4px;
+  background-color: rgba(0, 0, 0, 0.16);
+  transition: background-color 0.2s;
+}
+
+.item:hover .indicatorLine {
+  background-color: var(--dsw-alias-label-primary);
+}
+
+.item[data-active='true'] .indicatorLine {
+  background-color: var(--dsw-alias-brand-text);
+  transform: scale(1.5);
+}
+
+[data-ds-dark-theme] .indicatorLine {
+  background-color: rgba(255, 255, 255, 0.24);
+}
+
+.branchTag {
+  flex-shrink: 0;
+  margin-right: 6px;
+  padding: 0 4px;
+  border-radius: 4px;
+  background: var(--dsw-alias-markdown-citation, rgba(0, 0, 0, 0.06));
+  color: var(--dsw-alias-label-tertiary);
+  font: var(--dsw-font-xs-13);
+  line-height: 18px;
+  opacity: 0;
+  transition: opacity 0.1s;
+}
+
+.rail[data-show='true'] .branchTag {
+  opacity: 1;
+}
+
+[data-ds-dark-theme] .bg {
+  background-color: rgba(21, 21, 23, 0.6);
+}
+
+@media not all and (min-width: 768px) {
+  .rail {
+    display: none;
+  }
+}
diff --git a/src/components/messages/TurnRail.tsx b/src/components/messages/TurnRail.tsx
new file mode 100644
index 0000000..b8e6065
--- /dev/null
+++ b/src/components/messages/TurnRail.tsx
@@ -0,0 +1,136 @@
+import type { RefObject } from 'react'
+import { useEffect, useMemo, useRef, useState } from 'react'
+import { useTranslate } from '../../i18n/index.js'
+import type { MessageVersions } from '../../services/chat/branches.js'
+import type { Message } from '../../services/chat/types.js'
+import styles from './TurnRail.module.css'
+
+/** 一轮提问：用于刻度的锚点与预览文本。 */
+type Turn = { id: string; text: string }
+
+/**
+ * 右侧轮次导航：每轮提问一条刻度，悬停展开标题，点击跳到对应轮次。
+ * 几何对齐官网：右侧 16px、34px 宽的毛玻璃胶囊，悬停时内部 fit-content 容器展开（最宽 240）。
+ */
+export const TurnRail = ({
+  scrollRef,
+  messages,
+  versions,
+}: {
+  scrollRef: RefObject<HTMLDivElement | null>
+  messages: Message[]
+  versions: ReadonlyMap<string, MessageVersions>
+}) => {
+  const t = useTranslate()
+  const pageRef = useRef<HTMLDivElement>(null)
+  const turns = useMemo<Turn[]>(() => messages
+    .filter(message => message.role === 'user')
+    .map(message => ({ id: message.id, text: message.content.replace(/\s+/g, ' ').trim() })), [messages])
+  const [show, setShow] = useState(false)
+  const [active, setActive] = useState(0)
+  const [edges, setEdges] = useState({ top: false, bottom: false })
+
+  // 正文滚动时同步当前轮；落到回答里时归到它所属的提问
+  useEffect(() => {
+    const scroll = scrollRef.current
+    if (scroll === null || turns.length === 0) return
+    const update = () => {
+      if (scroll.scrollTop + scroll.clientHeight >= scroll.scrollHeight - 2) {
+        setActive(turns.length - 1)
+        return
+      }
+      const line = scroll.getBoundingClientRect().top + 40
+      let index = 0
+      turns.forEach((turn, position) => {
+        const node = scroll.querySelector(`[data-message-id="${CSS.escape(turn.id)}"]`)
+        if (node !== null && node.getBoundingClientRect().top <= line) index = position
+      })
+      setActive(index)
+    }
+    update()
+    scroll.addEventListener('scroll', update, { passive: true })
+    window.addEventListener('resize', update)
+    return () => {
+      scroll.removeEventListener('scroll', update)
+      window.removeEventListener('resize', update)
+    }
+  }, [scrollRef, turns])
+
+  // 当前轮在导航窗口外时，只滚动导航自身
+  useEffect(() => {
+    const page = pageRef.current
+    if (page === null) return
+    const item = page.querySelector<HTMLElement>(`[data-turn-index="${active}"]`)
+    if (item === null) return
+    if (item.offsetTop < page.scrollTop) {
+      page.scrollTop = item.offsetTop
+    } else if (item.offsetTop + item.offsetHeight > page.scrollTop + page.clientHeight) {
+      page.scrollTop = item.offsetTop + item.offsetHeight - page.clientHeight
+    }
+  }, [active, show])
+
+  // 只有真溢出的一侧才需要渐隐遮罩
+  const updateEdges = () => {
+    const page = pageRef.current
+    if (page === null) return
+    setEdges({
+      top: page.scrollTop > 1,
+      bottom: page.scrollTop + page.clientHeight < page.scrollHeight - 1,
+    })
+  }
+  useEffect(updateEdges, [turns.length, show])
+
+  // 官网少于两条不做导航
+  if (turns.length < 2) return null
+
+  const jump = (id: string) => {
+    const scroll = scrollRef.current
+    const node = scroll?.querySelector(`[data-message-id="${CSS.escape(id)}"]`)
+    if (scroll === null || node == null) return
+    setActive(turns.findIndex(turn => turn.id === id))
+    scroll.scrollTo({
+      top: scroll.scrollTop + node.getBoundingClientRect().top - scroll.getBoundingClientRect().top - 16,
+      behavior: 'smooth',
+    })
+  }
+
+  return (
+    <div
+      className={styles.rail}
+      data-show={show ? 'true' : undefined}
+      onMouseEnter={() => setShow(true)}
+      onMouseLeave={() => setShow(false)}
+    >
+      <div className={styles.bg} />
+      <div
+        className={styles.nav}
+        data-many={turns.length > 8 ? 'true' : undefined}
+        data-top={edges.top ? 'true' : undefined}
+        data-bottom={edges.bottom ? 'true' : undefined}
+      >
+        <div className={styles.page} ref={pageRef} onScroll={updateEdges}>
+          {turns.map((turn, index) => {
+            const version = versions.get(turn.id)
+            const branches = version?.ids.length ?? 1
+            const branchAt = (version?.index ?? 0) + 1
+            return (
+              <div
+                key={turn.id}
+                className={styles.item}
+                data-turn-index={index}
+                data-active={index === active ? 'true' : undefined}
+                onClick={() => jump(turn.id)}
+              >
+                {branches > 1 ? <span className={styles.branchTag}>{branchAt}/{branches}</span> : null}
+                <div className={styles.itemTitle}>{turn.text.length > 0 ? turn.text : t('untitledChat')}</div>
+                <div className={styles.itemIndicator}>
+                  <div className={styles.indicatorLine} />
+                </div>
+              </div>
+            )
+          })}
+        </div>
+      </div>
+    </div>
+  )
+}
