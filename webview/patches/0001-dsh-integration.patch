+/**
+ * 让某条消息出现在当前分支路径上：从目标逐级向上，把每层父节点的选中子节点指到这条链。
+ * 搜索结果可能命中旧版本的回答或更早的分支，点进去时要先把那一支选回来。
+ */
+export const revealMessage = async (sessionId: string, messageId: string): Promise<boolean> => {
+  await ensureSessionLoaded(sessionId)
+  const session = getSession(sessionId)
+  if (!session || getStreamController(sessionId)) {
+    return false
+  }
+  const byId = new Map(session.messages.map((message) => [message.id, message]))
+  const target = byId.get(messageId)
+  if (!target) {
+    return false
+  }
+  const selections = new Map<string, string>()
+  let current = target
+  while (current.parentId !== undefined && current.parentId !== null) {
+    selections.set(current.parentId, current.id)
+    const parent = byId.get(current.parentId)
+    if (!parent) {
+      break
+    }
+    current = parent
+  }
+  const changed = [...selections].some(([parentId, childId]) => byId.get(parentId)?.selectedChildId !== childId)
+  if (!changed) {
+    return true
+  }
+  updateSession(sessionId, (value) => ({
+    ...value,
+    messages: value.messages.map((message) => {
+      const childId = selections.get(message.id)
+      return childId === undefined ? message : { ...message, selectedChildId: childId }
+    }),
+  }))
+  persist(sessionId)
+  return true
+}
+/** 批量置顶/取消置顶：已加载的会话走缓存与持久化，未加载的直接写库。 */
+export const setPinnedMany = async (ids: string[], pinned: boolean): Promise<void> => {
+  if (get().importingHistory) {
+    return
+  }
+  const targets = new Set(ids)
+  if (targets.size === 0) {
+    return
+  }
+  set((state) => ({
+    sessions: state.sessions.map((session) =>
+      targets.has(session.id) ? { ...session, pinned } : session
+    ),
+  }))
+  await Promise.all([...targets].map(async (id) => {
+    const session = getSession(id)
+    if (session) {
+      updateSession(id, (value) => ({ ...value, pinned }))
+      persist(id)
+      return
+    }
+    await db.setPinned(id, pinned).catch(db.reportStorageError('pin sessions'))
+  }))
+}
+/** 切换置顶：列表先按置顶分组，组内仍按更新时间排序。 */
+export const togglePinned = (id: string) => {
+  if (get().importingHistory || deletingSessions.has(id)) {
+    return
+  }
+  const summary = get().sessions.find((session) => session.id === id)
+  if (summary === undefined) {
+    return
+  }
+  const pinned = summary.pinned !== true
+  set((state) => ({
+    sessions: state.sessions.map((session) =>
+      session.id === id ? { ...session, pinned } : session
+    ),
+  }))
+  const session = getSession(id)
+  if (session) {
+    updateSession(id, (value) => ({ ...value, pinned }))
+    persist(id)
+  } else {
+    void db.setPinned(id, pinned).catch(db.reportStorageError('pin session'))
+  }
+}
