+
+/** 会话搜索行里的角色图标：提问用人物，回答用 DeepSeek 小鲸鱼。 */
+
+export const UserGlyph = (): JSX.Element => (
+  <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" strokeWidth="1.3" strokeLinecap="round" aria-hidden>
