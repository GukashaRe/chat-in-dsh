+}
diff --git a/src/components/sider/SessionSearch.tsx b/src/components/sider/SessionSearch.tsx
new file mode 100644
index 0000000..26d805f
--- /dev/null
+++ b/src/components/sider/SessionSearch.tsx
@@ -0,0 +1,271 @@
+import { useEffect, useRef, useState } from 'react'
+import type { KeyboardEvent } from 'react'
+import { useTranslate } from '../../i18n/index.js'
+import { useSettings } from '../../services/settings.js'
+import { IconCloseFilled16, IconSearchFilled16 } from '../base/icons.js'
+import { loadSession } from '../../services/chat/db.js'
+import { revealMessage, selectSession, useChatStore } from '../../services/chat/store.js'
+import type { Message } from '../../services/chat/types.js'
+import {
+  closeSessionSearch,
+  requestScrollToMessage,
+  setSessionSearchQuery,
+  useSessionSearch,
+} from './sessionSearchState.js'
+import { UserGlyph, WhaleGlyph } from './sessionSearchGlyphs.js'
+import styles from './SessionSearch.module.css'
+
+/** 一条命中：标题行或消息行。 */
+type Hit = {
+  kind: 'title' | 'message'
+  sessionId: string
+  messageId: string
+  title: string
+  snippet: string
+  at: number
+  role: Message['role']
+}
+
+const MAX_HITS = 60
+
+/** 消息的可搜索文本：提问取正文，回答取思考与正文（官网也会命中思考过程）。 */
+const messageText = (message: Message): string => message.role === 'user'
+  ? message.content
+  : message.blocks
+    .flatMap((block) => {
+      if (block.type === 'text') return [block.text]
+      if (block.type === 'thinking') return [block.thinking]
+      return []
+    })
+    .join('\n')
+
+/** 截取首个命中附近的片段，两端超出的部分用省略号。 */
+const makeSnippet = (text: string, index: number, length: number): string => {
+  const start = Math.max(0, index - 30)
+  const end = Math.min(text.length, index + length + 60)
+  return `${start > 0 ? '…' : ''}${text.slice(start, end).replace(/\s+/g, ' ')}${end < text.length ? '…' : ''}`
+}
+
+/** 所有命中位置都加粗，不再只标第一处。 */
+const highlight = (text: string, needle: string, markClass: string) => {
+  if (needle.length === 0) return text
+  const nodes: React.ReactNode[] = []
+  let cursor = 0
+  let index = text.toLowerCase().indexOf(needle)
+  while (index >= 0) {
+    if (index > cursor) nodes.push(text.slice(cursor, index))
+    nodes.push(<mark key={index} className={markClass}>{text.slice(index, index + needle.length)}</mark>)
+    cursor = index + needle.length
+    index = text.toLowerCase().indexOf(needle, cursor)
+  }
+  if (cursor < text.length) nodes.push(text.slice(cursor))
+  return nodes.length > 0 ? nodes : text
+}
+
+const pad = (value: number): string => `${value}`.padStart(2, '0')
+
+const sameDay = (a: Date, b: Date): boolean =>
+  a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate()
+
+/** 日期格式对齐官网：今天 HH:mm，昨天「昨天」，当年 M月D日，跨年带年份。 */
+const formatDate = (at: number, locale: string, t: (key: 'sessionHistoryTimelineLabelYesterday') => string): string => {
+  const date = new Date(at)
+  const now = new Date()
+  if (sameDay(date, now)) return `${pad(date.getHours())}:${pad(date.getMinutes())}`
+  const yesterday = new Date(now)
+  yesterday.setDate(now.getDate() - 1)
+  if (sameDay(date, yesterday)) return t('sessionHistoryTimelineLabelYesterday')
+  const month = date.getMonth() + 1
+  const day = date.getDate()
+  if (locale.startsWith('zh')) {
+    return date.getFullYear() === now.getFullYear()
+      ? `${month}月${day}日`
+      : `${date.getFullYear()}年${month}月${day}日`
+  }
+  return date.getFullYear() === now.getFullYear()
+    ? `${month}/${day}`
+    : `${month}/${day}/${date.getFullYear()}`
+}
+
+/**
+ * 会话搜索浮层：按标题与正文检索本地对话。
+ * 标题命中单独成行，消息命中逐条列出；结构与尺寸对齐网页版。
+ */
+export const SessionSearch = () => {
+  const t = useTranslate()
+  const locale = useSettings(state => state.locale)
+  const open = useSessionSearch(state => state.open)
+  const query = useSessionSearch(state => state.query)
+  const sessions = useChatStore(state => state.sessions)
+  const [hits, setHits] = useState<Hit[]>([])
+  const [active, setActive] = useState(0)
+  const [searching, setSearching] = useState(false)
+  const inputRef = useRef<HTMLInputElement>(null)
+  const listRef = useRef<HTMLDivElement>(null)
+  const needle = query.trim().toLowerCase()
+
+  useEffect(() => {
+    if (open) inputRef.current?.focus()
+  }, [open])
+
+  useEffect(() => {
+    if (!open) return
+    if (needle.length === 0) {
+      setHits([])
+      setSearching(false)
+      return
+    }
+    let cancelled = false
+    setSearching(true)
+    const timer = setTimeout(() => {
+      void (async () => {
+        const found: Hit[] = []
+        for (const summary of sessions) {
+          const titleHit = summary.title.toLowerCase().includes(needle)
+          const session = await loadSession(summary.id).catch(() => undefined)
+          if (session === undefined) continue
+          if (titleHit) {
+            found.push({
+              kind: 'title',
+              sessionId: summary.id,
+              messageId: '',
+              title: summary.title,
+              snippet: summary.title,
+              at: summary.updatedAt,
+              role: 'assistant',
+            })
+          }
+          for (const message of session.messages) {
+            const text = messageText(message)
+            const index = text.toLowerCase().indexOf(needle)
+            if (index < 0) continue
+            found.push({
+              kind: 'message',
+              sessionId: summary.id,
+              messageId: message.id,
+              title: summary.title,
+              snippet: makeSnippet(text, index, needle.length),
+              at: message.createdAt,
+              role: message.role,
+            })
+          }
+        }
+        if (cancelled) return
+        // 先排序再截断，避免先截断漏掉较新的命中
+        found.sort((a, b) => b.at - a.at)
+        setHits(found.slice(0, MAX_HITS))
+        setActive(0)
+        setSearching(false)
+      })()
+    }, 200)
+    return () => {
+      cancelled = true
+      clearTimeout(timer)
+    }
+  }, [open, needle, sessions])
+
+  // 键盘移动选中项时把它滚进视野
+  useEffect(() => {
+    listRef.current?.querySelector<HTMLElement>(`[data-index="${active}"]`)?.scrollIntoView({ block: 'nearest' })
+  }, [active, hits])
+
+  if (!open) return null
+
+  const choose = (hit: Hit) => {
+    selectSession(hit.sessionId)
+    closeSessionSearch()
+    if (hit.messageId.length === 0) return
+    // 命中可能落在旧分支：先把那一支选回当前路径，再让消息列表滚过去
+    void revealMessage(hit.sessionId, hit.messageId).then((revealed) => {
+      if (revealed) requestScrollToMessage(hit.sessionId, hit.messageId)
+    })
+  }
+
+  const onKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.key === 'Escape') {
+      event.preventDefault()
+      closeSessionSearch()
+      return
+    }
+    if (hits.length === 0) return
+    if (event.key === 'ArrowDown') {
+      event.preventDefault()
+      setActive(index => (index + 1) % hits.length)
+      return
+    }
+    if (event.key === 'ArrowUp') {
+      event.preventDefault()
+      setActive(index => (index - 1 + hits.length) % hits.length)
+      return
+    }
+    if (event.key === 'Enter') {
+      event.preventDefault()
+      choose(hits[Math.min(active, hits.length - 1)])
+    }
+  }
+
+  return (
+    <div className={styles.overlay} onClick={closeSessionSearch}>
+      <div className={styles.frame}>
+      <div
+        className={styles.dialog}
+        data-expanded={needle.length > 0 ? 'true' : undefined}
+        role="dialog"
+        aria-label={t('searchSessionsButton')}
+        onClick={event => event.stopPropagation()}
+      >
+        <div className={styles.field}>
+          <span className={styles.fieldIcon}><IconSearchFilled16 /></span>
+          <input
+            ref={inputRef}
+            className={styles.input}
+            value={query}
+            placeholder={t('searchSessionsPlaceholder')}
+            onChange={event => setSessionSearchQuery(event.target.value)}
+            onKeyDown={onKeyDown}
+          />
+          <span className={styles.separator} />
+          <span className={styles.actions}>
+            <button type="button" className={styles.close} aria-label={t('close')} onClick={closeSessionSearch}>
+              <IconCloseFilled16 />
+            </button>
+          </span>
+        </div>
+        <div className={styles.list} role="listbox" aria-label={t('searchSessionsButton')} ref={listRef}>
+          {needle.length === 0 ? null : hits.length === 0 ? (
+            <div className={styles.empty}>{searching ? t('searchSessionsSearching') : t('searchSessionsNoResult')}</div>
+          ) : (
+            hits.map((hit, index) => (
+              <button
+                key={`${hit.kind}-${hit.sessionId}-${hit.messageId}-${hit.at}-${index}`}
+                type="button"
+                role="option"
+                aria-selected={index === active}
+                data-index={index}
+                data-kind={hit.kind}
+                data-active={index === active ? 'true' : undefined}
+                className={styles.item}
+                onMouseMove={() => setActive(previous => (previous === index ? previous : index))}
+                onClick={() => choose(hit)}
+              >
+                <span className={styles.glyph} data-role={hit.role}>
+                  {hit.role === 'user' ? <UserGlyph /> : <WhaleGlyph />}
+                </span>
+                <span className={styles.body}>
+                  <span className={styles.titleRow}>
+                    <span className={styles.title}>{highlight(hit.title, needle, styles.mark)}</span>
+                    <span className={styles.date}>{formatDate(hit.at, locale, t)}</span>
+                  </span>
+                  {hit.kind === 'message' ? (
+                    <span className={styles.snippet}>{highlight(hit.snippet, needle, styles.mark)}</span>
+                  ) : null}
+                </span>
+              </button>
+            ))
+          )}
+        </div>
+      </div>
+      </div>
+    </div>
+  )
+}
