diff --git a/src/components/sider/SessionSearch.tsx b/src/components/sider/SessionSearch.tsx
new file mode 100644
index 0000000..bc8f393
--- /dev/null
+++ b/src/components/sider/SessionSearch.tsx
@@ -0,0 +1,199 @@
+import { useEffect, useRef, useState } from 'react'
+import type { KeyboardEvent } from 'react'
+import { useTranslate } from '../../i18n/index.js'
+import { useSettings } from '../../services/settings.js'
+import { IconCloseOutline16, IconSearchOutline16 } from '../base/icons.js'
+import { loadSession } from '../../services/chat/db.js'
+import { selectSession, useChatStore } from '../../services/chat/store.js'
+import type { Message } from '../../services/chat/types.js'
+import { closeSessionSearch, setSessionSearchQuery, useSessionSearch } from './sessionSearchState.js'
+import { UserGlyph, WhaleGlyph } from './sessionSearchGlyphs.js'
+import styles from './SessionSearch.module.css'
+
+/** 一条命中：一条消息的片段，或标题命中时合成的摘要行。 */
+type Hit = {
+  sessionId: string
+  title: string
+  snippet: string
+  at: number
+  role: Message['role']
+}
+
+const MAX_HITS = 60
+
+/** 消息的可搜索文本：提问取正文，回答取文本块（不含思考）。 */
+const messageText = (message: Message): string => message.role === 'user'
+  ? message.content
+  : message.blocks
+    .flatMap(block => (block.type === 'text' ? [block.text] : []))
+    .join('\n')
+
+/** 截取命中位置附近的片段，两端超出的部分用省略号。 */
+const makeSnippet = (text: string, index: number, length: number): string => {
+  const start = Math.max(0, index - 30)
+  const end = Math.min(text.length, index + length + 60)
+  return `${start > 0 ? '…' : ''}${text.slice(start, end).replace(/\s+/g, ' ')}${end < text.length ? '…' : ''}`
+}
+
+const formatDate = (at: number, locale: string): string => new Intl.DateTimeFormat(locale, {
+  month: 'long',
+  day: 'numeric',
+}).format(new Date(at))
+
+/**
+ * 会话搜索浮层：按标题与正文检索本地对话，结果按消息逐条列出。
+ * 交互对齐网页版：暗背景居中面板、Esc 关闭、回车打开第一条。
+ */
+export const SessionSearch = () => {
+  const t = useTranslate()
+  const locale = useSettings(state => state.locale)
+  const open = useSessionSearch(state => state.open)
+  const query = useSessionSearch(state => state.query)
+  const sessions = useChatStore(state => state.sessions)
+  const [hits, setHits] = useState<Hit[]>([])
+  const [active, setActive] = useState(0)
+  const [searching, setSearching] = useState(false)
+  const inputRef = useRef<HTMLInputElement>(null)
+  const needle = query.trim().toLowerCase()
+
+  useEffect(() => {
+    if (open) inputRef.current?.focus()
+  }, [open])
+
+  useEffect(() => {
+    if (!open) return
+    if (needle.length === 0) {
+      setHits([])
+      setSearching(false)
+      return
+    }
+    let cancelled = false
+    setSearching(true)
+    const timer = setTimeout(() => {
+      void (async () => {
+        const found: Hit[] = []
+        for (const summary of sessions) {
+          if (found.length >= MAX_HITS) break
+          const titleHit = summary.title.toLowerCase().includes(needle)
+          const session = await loadSession(summary.id).catch(() => undefined)
+          if (session === undefined) continue
+          let messageHit = false
+          for (const message of session.messages) {
+            const text = messageText(message)
+            const index = text.toLowerCase().indexOf(needle)
+            if (index < 0) continue
+            messageHit = true
+            found.push({
+              sessionId: summary.id,
+              title: summary.title,
+              snippet: makeSnippet(text, index, needle.length),
+              at: message.createdAt,
+              role: message.role,
+            })
+            if (found.length >= MAX_HITS) break
+          }
+          if (titleHit && !messageHit) {
+            found.push({
+              sessionId: summary.id,
+              title: summary.title,
+              snippet: summary.title,
+              at: summary.updatedAt,
+              role: 'assistant',
+            })
+          }
+        }
+        if (cancelled) return
+        found.sort((a, b) => b.at - a.at)
+        setHits(found.slice(0, MAX_HITS))
+        setActive(0)
+        setSearching(false)
+      })()
+    }, 150)
+    return () => {
+      cancelled = true
+      clearTimeout(timer)
+    }
+  }, [open, needle, sessions])
+
+  if (!open) return null
+
+  const choose = (sessionId: string) => {
+    selectSession(sessionId)
+    closeSessionSearch()
+  }
+
+  const onKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.key === 'Escape') {
+      event.preventDefault()
+      closeSessionSearch()
+      return
+    }
+    if (event.key === 'ArrowDown') {
+      event.preventDefault()
+      setActive(index => Math.min(hits.length - 1, index + 1))
+      return
+    }
+    if (event.key === 'ArrowUp') {
+      event.preventDefault()
+      setActive(index => Math.max(0, index - 1))
+      return
+    }
+    if (event.key === 'Enter' && hits.length > 0) {
+      event.preventDefault()
+      choose(hits[Math.min(active, hits.length - 1)].sessionId)
+    }
+  }
+
+  return (
+    <div className={styles.overlay} onClick={closeSessionSearch}>
+      <div
+        className={styles.dialog}
+        role="dialog"
+        aria-label={t('searchSessionsButton')}
+        onClick={event => event.stopPropagation()}
+      >
+        <div className={styles.field}>
+          <span className={styles.fieldIcon}><IconSearchOutline16 /></span>
+          <input
+            ref={inputRef}
+            className={styles.input}
+            value={query}
+            placeholder={t('searchSessionsPlaceholder')}
+            onChange={event => setSessionSearchQuery(event.target.value)}
+            onKeyDown={onKeyDown}
+          />
+          <button type="button" className={styles.close} aria-label={t('close')} onClick={closeSessionSearch}>
+            <IconCloseOutline16 />
+          </button>
+        </div>
+        {needle.length === 0 ? null : (
+          <div className={styles.list}>
+            {hits.length === 0 ? (
+              <div className={styles.empty}>{searching ? t('sessionLoading') : t('searchSessionsNoResult')}</div>
+            ) : (
+              hits.map((hit, index) => (
+                <button
+                  key={`${hit.sessionId}-${hit.at}-${index}`}
+                  type="button"
+                  className={styles.item}
+                  data-active={index === active ? 'true' : undefined}
+                  onMouseEnter={() => setActive(index)}
+                  onClick={() => choose(hit.sessionId)}
+                >
+                  <span className={styles.glyph} data-role={hit.role}>
+                    {hit.role === 'user' ? <UserGlyph /> : <WhaleGlyph />}
+                  </span>
+                  <span className={styles.body}>
