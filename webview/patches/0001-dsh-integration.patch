+const importPendingDsh = async (): Promise<void> => {
+  try {
+    const response = await fetch('/webchat/api/import/pending')
+    if (!response.ok) return
+    const pending = (await response.json()) as Session[]
+    if (!Array.isArray(pending) || pending.length === 0) return
+    for (const session of pending) {
+      await db.saveSession(session)
+    }
+    await fetch('/webchat/api/import/ack', {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ ids: pending.map((session) => session.id) }),
+    })
+  } catch {
+    // 导入失败不影响正常启动。
+  }
+}
