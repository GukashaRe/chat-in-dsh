diff --git a/src/components/sider/SessionSearch.tsx b/src/components/sider/SessionSearch.tsx
new file mode 100644
index 0000000..632af1a
--- /dev/null
+++ b/src/components/sider/SessionSearch.tsx
@@ -0,0 +1,166 @@
+import clsx from 'clsx'
+import { useEffect, useRef, useState } from 'react'
+import { useTranslate } from '../../i18n/index.js'
+import { IconSearchOutline16 } from '../base/icons.js'
+import { loadSession } from '../../services/chat/db.js'
+import { selectSession, useChatStore } from '../../services/chat/store.js'
+import type { Message, SessionSummary } from '../../services/chat/types.js'
+import { closeSessionSearch, setSessionSearchQuery, useSessionSearch } from './sessionSearchState.js'
+import styles from './SessionSearch.module.css'
+
+/** 一条命中：会话摘要、展示用的片段、时间。 */
+type Hit = SessionSummary & { snippet: string }
+
+/** 消息的可搜索文本：提问取正文，回答取文本块（不含思考）。 */
+const messageText = (message: Message): string => message.role === 'user'
+  ? message.content
+  : message.blocks
+    .flatMap(block => (block.type === 'text' ? [block.text] : []))
+    .join('\n')
+
+/** 截取命中位置附近的片段，两端超出的部分用省略号。 */
+const makeSnippet = (text: string, needle: string): string => {
+  const index = text.toLowerCase().indexOf(needle)
+  if (index < 0) return text.slice(0, 60)
+  const start = Math.max(0, index - 24)
+  const end = Math.min(text.length, index + needle.length + 48)
+  return `${start > 0 ? '…' : ''}${text.slice(start, end).replace(/\s+/g, ' ')}${end < text.length ? '…' : ''}`
+}
+
+/** 把片段里的关键词标成高亮。 */
+const highlight = (text: string, needle: string) => {
+  if (needle.length === 0) return text
+  const index = text.toLowerCase().indexOf(needle)
+  if (index < 0) return text
+  return (
+    <>
+      {text.slice(0, index)}
+      <mark className={styles.mark}>{text.slice(index, index + needle.length)}</mark>
+      {text.slice(index + needle.length)}
+    </>
+  )
+}
+
+/**
+ * 会话搜索浮层：按标题与正文检索本地对话，回车或点击打开对应会话。
+ * 交互对齐网页版：点搜索按钮打开，Esc 关闭。
+ */
+export const SessionSearch = () => {
+  const t = useTranslate()
+  const open = useSessionSearch(state => state.open)
+  const query = useSessionSearch(state => state.query)
+  const sessions = useChatStore(state => state.sessions)
+  const [hits, setHits] = useState<Hit[]>([])
+  const [active, setActive] = useState(0)
+  const [searching, setSearching] = useState(false)
+  const inputRef = useRef<HTMLInputElement>(null)
+  const needle = query.trim().toLowerCase()
+
+  useEffect(() => {
+    if (!open) return
+    inputRef.current?.focus()
+  }, [open])
+
+  useEffect(() => {
+    if (!open) return
+    if (needle.length === 0) {
+      setHits([])
+      setSearching(false)
+      return
+    }
+    let cancelled = false
+    setSearching(true)
+    const timer = setTimeout(() => {
+      void (async () => {
+        const found: Hit[] = []
+        for (const summary of sessions) {
+          if (summary.title.toLowerCase().includes(needle)) {
+            found.push({ ...summary, snippet: summary.title })
+            continue
+          }
+          const session = await loadSession(summary.id).catch(() => undefined)
+          if (session === undefined) continue
+          const hit = session.messages.find(message => messageText(message).toLowerCase().includes(needle))
+          if (hit !== undefined) found.push({ ...summary, snippet: makeSnippet(messageText(hit), needle) })
+        }
+        if (cancelled) return
+        found.sort((a, b) => b.updatedAt - a.updatedAt)
+        setHits(found)
+        setActive(0)
+        setSearching(false)
+      })()
+    }, 150)
+    return () => {
+      cancelled = true
+      clearTimeout(timer)
+    }
+  }, [open, needle, sessions])
+
+  if (!open) return null
+
+  const choose = (id: string) => {
+    selectSession(id)
+    closeSessionSearch()
+  }
+
+  const onKeyDown = (event: React.KeyboardEvent<HTMLInputElement>) => {
+    if (event.key === 'Escape') {
+      event.preventDefault()
+      closeSessionSearch()
+      return
+    }
+    if (event.key === 'ArrowDown') {
+      event.preventDefault()
+      setActive(index => Math.min(hits.length - 1, index + 1))
+      return
+    }
+    if (event.key === 'ArrowUp') {
+      event.preventDefault()
+      setActive(index => Math.max(0, index - 1))
+      return
+    }
+    if (event.key === 'Enter' && hits.length > 0) {
+      event.preventDefault()
+      choose(hits[Math.min(active, hits.length - 1)].id)
+    }
+  }
+
+  return (
+    <>
+      <div className={styles.backdrop} onClick={closeSessionSearch} />
+      <div className={styles.panel} role="dialog" aria-label={t('searchSessionsButton')}>
+        <div className={styles.field}>
+          <span className={styles.fieldIcon}><IconSearchOutline16 /></span>
+          <input
+            ref={inputRef}
+            className={styles.input}
+            value={query}
+            placeholder={t('searchSessionsPlaceholder')}
+            onChange={event => setSessionSearchQuery(event.target.value)}
+            onKeyDown={onKeyDown}
+          />
+        </div>
+        <div className={styles.list}>
+          {needle.length === 0 ? null : hits.length === 0 ? (
+            <div className={styles.empty}>{searching ? t('sessionLoading') : t('searchSessionsNoResult')}</div>
+          ) : (
+            hits.map((hit, index) => (
+              <button
+                key={hit.id}
+                type="button"
+                className={clsx(styles.item, index === active && styles.itemActive)}
+                onMouseEnter={() => setActive(index)}
+                onClick={() => choose(hit.id)}
+              >
+                <div className={styles.title}>{highlight(hit.title, needle)}</div>
+                {hit.snippet === hit.title ? null : (
+                  <div className={styles.snippet}>{highlight(hit.snippet, needle)}</div>
+                )}
+              </button>
+            ))
+          )}
+        </div>
+      </div>
+    </>
+  )
+}
