+/* 尺寸与结构对齐官网：660px 宽、72vh 高、结果行最小 67px。 */
+.overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 40;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: rgba(0, 0, 0, 0.36);
+  -webkit-backdrop-filter: blur(2px);
+  backdrop-filter: blur(2px);
+}
+
+/* 官网结构：居中的 72vh 容器，面板贴在容器顶部，展开时占满 */
+.frame {
+  display: flex;
+  flex-direction: column;
+  width: min(660px, 100vw - 24px);
+  height: 72vh;
+  max-height: calc(100% - 32px);
+}
+
+.dialog {
+  display: flex;
+  flex-direction: column;
+  box-sizing: border-box;
+  width: 100%;
+  height: auto;
